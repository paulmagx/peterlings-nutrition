---
/**
 * Botanische Strichzeichnung: ein Petersilienzweig aus denselben Blättern wie das Logo.
 * Rein dekorativ (aria-hidden). Farbe über currentColor, Größe und Lage über class.
 * Mit `draw` zeichnet sich der Zweig beim Hineinscrollen selbst (reines CSS,
 * entfällt bei „Bewegung reduzieren“ und in Browsern ohne Scroll-Animationen).
 */
import { leafletPath, leafletTransforms, stemPath } from "../lib/parsley";

interface Props {
  class?: string;
  draw?: boolean;
  /** Spiegelt den Zweig horizontal. */
  flip?: boolean;
}
const { class: className = "", draw = true, flip = false } = Astro.props;

// Ein „Blatt“ = drei Teilblätter am Stielchen, angesetzt am Stielende (9.4|22.4 im Logo-Raster).
// [x, y, Drehung, Größe]
const leaves: [number, number, number, number][] = [
  [104, 46, 4, 3.6],
  [102, 116, 42, 2.9],
  [99, 132, -38, 3.0],
  [101, 200, 46, 3.1],
  [99, 218, -44, 3.2],
  [100, 284, 40, 2.7],
  [97, 302, -42, 2.8],
];
const mainStem = "M100 358C96 300 108 240 100 180S92 92 104 46";
---

<svg
  viewBox="0 0 200 360"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class:list={["botanical", draw && "botanical-draw", className]}
  style={flip ? "transform: scaleX(-1)" : undefined}
>
  <path
    d={mainStem}
    stroke="currentColor"
    stroke-width="1.25"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"
    pathLength="1"
  />
  {leaves.map(([x, y, rot, s]) => (
    <g
      transform={`translate(${x} ${y}) rotate(${rot}) scale(${s}) translate(-9.4 -22.4)`}
    >
      <path
        d={stemPath}
        stroke="currentColor"
        stroke-width="1.25"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
        pathLength="1"
      />
      {leafletTransforms.map((t) => (
        <path
          transform={t}
          d={leafletPath}
          fill="currentColor"
          fill-opacity="0.07"
          stroke="currentColor"
          stroke-width="1.1"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
          pathLength="1"
        />
      ))}
    </g>
  ))}
</svg>

<style>
  @keyframes botanical-draw {
    from {
      stroke-dashoffset: 1;
      fill-opacity: 0;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .botanical-draw path {
        stroke-dasharray: 1;
        animation: botanical-draw linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 45%;
      }
    }
  }
</style>
