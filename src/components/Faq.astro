---
import Icon from "./Icon.astro";
import type { FaqItem } from "../data/faq";

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;

// Nur Fragen ohne offenes todo kommen ins JSON-LD.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items
    .filter((item) => !item.todo)
    .map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
};
const hasStructuredData = jsonLd.mainEntity.length > 0;
---

<div class="divide-y divide-line border-y border-line">
  {items.map((item) => (
    <details class="group">
      {item.todo && (
        <Fragment set:html={`<!-- ${item.todo.replace(/--/g, "–")} -->`} />
      )}
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[1.1875rem] font-semibold tracking-tight marker:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600 md:py-7 md:text-[1.375rem] [&::-webkit-details-marker]:hidden">
        <span>{item.question}</span>
        <Icon
          name="add-rounded"
          class="size-7 shrink-0 text-sage-700 transition-transform duration-200 group-open:rotate-45 motion-reduce:transition-none"
        />
      </summary>
      <p class="max-w-2xl pb-7 text-muted">{item.answer}</p>
    </details>
  ))}
</div>

{hasStructuredData && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
