---
import Icon from "./Icon.astro";
import type { FaqItem } from "../data/faq";

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;

// Nur Fragen ohne offenes todo kommen ins JSON-LD.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items
    .filter((item) => !item.todo)
    .map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
};
const hasStructuredData = jsonLd.mainEntity.length > 0;
---

<div class="divide-y divide-sage-200 rounded-2xl border border-sage-200 bg-white">
  {items.map((item) => (
    <details class="group">
      {item.todo && (
        <Fragment set:html={`<!-- ${item.todo.replace(/--/g, "–")} -->`} />
      )}
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-2xl p-5 font-bold marker:hidden focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-sage-600 [&::-webkit-details-marker]:hidden">
        <span>{item.question}</span>
        <Icon
          name="expand-more-rounded"
          class="size-6 shrink-0 text-sage-700 transition-transform group-open:rotate-180 motion-reduce:transition-none"
        />
      </summary>
      <p class="px-5 pb-5 text-muted">{item.answer}</p>
    </details>
  ))}
</div>

{hasStructuredData && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
