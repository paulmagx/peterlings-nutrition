---
/**
 * Schmale, durchscheinende Kopfzeile. Ab md: Navigation in der Mitte.
 * Auf dem Handy öffnet ein Menü-Button eine ganzseitige Navigation.
 */
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { mainNav, bookingLink } from "../data/site";
import { isActive } from "../lib/nav";

const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-black/[0.06] bg-white/75 backdrop-blur-xl backdrop-saturate-150"
  data-site-header
>
  <div class="mx-auto flex h-13 max-w-6xl items-center justify-between gap-4 px-5 sm:px-6">
    <Logo />

    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex items-center gap-1 lg:gap-3">
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(path, item.href) ? "page" : undefined}
              class="rounded-full px-3 py-1.5 text-[0.8125rem] whitespace-nowrap text-ink/80 transition-colors hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={bookingLink.href}
        aria-current={isActive(path, bookingLink.href) ? "page" : undefined}
        class="rounded-full bg-sage-700 px-3.5 py-1.5 text-[0.8125rem] font-medium whitespace-nowrap text-white transition hover:bg-sage-800 active:scale-95"
      >
        {bookingLink.label}
      </a>
      <button
        type="button"
        class="-mr-2 flex size-11 items-center justify-center rounded-full text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label>
          Menü öffnen
        </span>
        <Icon name="menu-rounded" class="size-6" data-icon-open />
        <Icon name="close-rounded" class="hidden size-6" data-icon-close />
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Hauptnavigation (Menü)"
    class="hidden h-[calc(100dvh-3.25rem)] overflow-y-auto bg-white px-8 pt-6 pb-12 md:hidden"
    data-menu
  >
    <ul class="space-y-1">
      {mainNav.map((item, i) => (
        <li class="menu-item" style={`--i:${i}`}>
          <a
            href={item.href}
            aria-current={isActive(path, item.href) ? "page" : undefined}
            class="block py-2 text-[1.75rem] leading-tight font-semibold tracking-tight text-ink/85 hover:text-ink aria-[current=page]:text-sage-700"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  [data-menu][data-open] .menu-item {
    animation: menu-in 0.35s var(--ease-soft) both;
    animation-delay: calc(var(--i) * 35ms);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }
</style>

<script>
  const toggle =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const label = toggle?.querySelector<HTMLElement>("[data-menu-label]");
  const iconOpen = toggle?.querySelector<SVGElement>("[data-icon-open]");
  const iconClose = toggle?.querySelector<SVGElement>("[data-icon-close]");

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    menu.classList.toggle("hidden", !open);
    menu.toggleAttribute("data-open", open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    if (label) label.textContent = open ? "Menü schließen" : "Menü öffnen";
    document.documentElement.style.overflow = open ? "hidden" : "";
  }

  toggle?.addEventListener("click", () =>
    setOpen(toggle.getAttribute("aria-expanded") !== "true"),
  );
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      toggle?.getAttribute("aria-expanded") === "true"
    ) {
      setOpen(false);
      toggle.focus();
    }
  });
  // Beim Wechsel auf Desktop-Breite Menü schließen
  matchMedia("(min-width: 48rem)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>
