---
import Logo from "./Logo.astro";
import { mainNav, bookingLink } from "../data/site";
import { isActive } from "../lib/nav";

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-sage-200/60 bg-surface/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 lg:gap-6 sm:px-6">
    <Logo />

    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex items-center gap-0.5 lg:gap-1">
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(path, item.href) ? "page" : undefined}
              class="rounded-full px-2.5 py-2 text-sm font-semibold whitespace-nowrap text-muted lg:px-4 transition-colors hover:bg-sage-100 hover:text-sage-800 decoration-2 underline-offset-4 aria-[current=page]:bg-sage-100 aria-[current=page]:text-sage-800 aria-[current=page]:underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href={bookingLink.href}
      aria-current={isActive(path, bookingLink.href) ? "page" : undefined}
      class="rounded-full bg-sage-600 px-4 py-2 text-sm font-semibold whitespace-nowrap text-white shadow-sm transition hover:bg-sage-700 active:scale-95"
    >
      {bookingLink.label}
    </a>
  </div>
</header>
