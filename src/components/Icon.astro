---
/**
 * Material-Symbols-Icon als Inline-SVG, zur Build-Zeit erzeugt.
 * Keine Icon-Schrift, keine Anfrage an Google. Namen: https://icon-sets.iconify.design/material-symbols/
 */
import { icons } from "@iconify-json/material-symbols";
import { getIconData, iconToSVG, replaceIDs } from "@iconify/utils";

interface Props {
  name: string;
  class?: string;
  /** Wenn gesetzt, wird das Icon für Screenreader beschriftet, sonst ist es dekorativ. */
  label?: string;
}

const { name, class: className = "size-6", label } = Astro.props;
const data = getIconData(icons, name);
if (!data) throw new Error(`Icon "${name}" gibt es in Material Symbols nicht.`);
const { attributes, body } = iconToSVG(data);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={attributes.viewBox}
  class={className}
  fill="currentColor"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={replaceIDs(body)}
/>
