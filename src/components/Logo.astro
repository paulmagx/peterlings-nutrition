---
import ParsleyMark from "./ParsleyMark.astro";
import { site } from "../data/site";
---

<a
  href="/"
  class="flex items-center gap-1 text-ink transition-opacity hover:opacity-70"
  aria-label={`${site.name} – zur Startseite`}
>
  <ParsleyMark class="size-6 text-sage-700" veins={false} />
  <span class="text-[1.0625rem] font-semibold tracking-tight">
    {site.shortName}
  </span>
</a>
