---
import Icon from "./Icon.astro";
import { mainNav } from "../data/site";
import { isActive } from "../lib/nav";

const path = Astro.url.pathname;
---

<nav
  aria-label="Navigation"
  class="fixed inset-x-0 bottom-4 z-50 mx-auto w-[calc(100%-2rem)] max-w-sm rounded-full border border-sage-200 bg-white/95 px-2 py-2 shadow-xl backdrop-blur-xl md:hidden"
>
  <ul class="flex items-center justify-between">
    {mainNav.map((item) => (
      <li class="min-w-0 flex-1">
        <a
          href={item.href}
          aria-current={isActive(path, item.href) ? "page" : undefined}
          class="flex flex-col items-center gap-0.5 rounded-full px-0 py-1 text-slate-500 transition-colors hover:text-sage-700 aria-[current=page]:text-sage-700"
        >
          <Icon name={item.icon} class="size-6" />
          <span class="text-[10.5px] font-bold min-[360px]:text-[11px] whitespace-nowrap">
            {item.label}
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>
