---
/**
 * Newsletter-Anmeldung mit Double-Opt-in (Bestätigungsmail kommt vom Dienst).
 * Normales POST-Formular, funktioniert ohne JavaScript.
 * Rendert nichts, solange newsletter.enabled false ist oder formAction ein Platzhalter ist.
 */
import { newsletter } from "../data/newsletter";
import { isPlaceholder } from "../lib/placeholder";

// Nur für `npm run check:a11y`: im Dev-Server testweise anzeigen (A11Y_FORMS_PREVIEW=1).
const a11yPreview =
  import.meta.env.DEV && process.env.A11Y_FORMS_PREVIEW === "1";
const show =
  a11yPreview || (newsletter.enabled && !isPlaceholder(newsletter.formAction));
const formAction = isPlaceholder(newsletter.formAction)
  ? "/"
  : newsletter.formAction;
---

{show && (
  <section
    aria-labelledby="nl-heading"
    class="mb-8 grid gap-6 border-b border-line pb-8 md:grid-cols-2 md:items-start md:gap-12"
  >
    <div>
      <h2 id="nl-heading" class="text-xl font-semibold tracking-tight text-ink">
        Newsletter
      </h2>
      <p class="mt-2 max-w-sm text-muted">
        Ab und zu ein paar Gedanken und Tipps rund um Ernährung, direkt in dein
        Postfach.
      </p>
    </div>

    <form action={formAction} method="post" class="relative grid gap-4">
      <div>
        <label
          for="nl-email"
          class="block text-[0.9375rem] font-medium text-ink"
        >
          E-Mail
        </label>
        <div class="mt-2 flex flex-col gap-3 sm:flex-row">
          <input
            id="nl-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="block w-full min-w-0 rounded-full border border-muted bg-white px-5 py-3 text-[1rem] text-ink focus:border-sage-700 focus:ring-2 focus:ring-sage-700/20 focus:outline-none"
          />
          <button
            type="submit"
            class="inline-flex shrink-0 items-center justify-center rounded-full bg-sage-700 px-6 py-3 text-[1rem] font-medium text-white transition duration-200 ease-soft hover:bg-sage-800 active:scale-[0.98]"
          >
            Anmelden
          </button>
        </div>
      </div>

      <div
        class="absolute -left-[9999px] h-0 w-0 overflow-hidden"
        aria-hidden="true"
      >
        <label for="nl-website">Bitte leer lassen</label>
        <input
          id="nl-website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div class="flex items-start gap-3">
        <input
          id="nl-consent"
          name="consent"
          type="checkbox"
          value="ja"
          required
          class="mt-0.5 size-6 shrink-0 accent-sage-700"
        />
        {/* TODO(Lea): Versandhäufigkeit („ca. einmal im Monat“) bestätigen, bevor der Newsletter eingeschaltet wird. */}
        <label for="nl-consent" class="text-muted">
          Ich möchte den Newsletter von Peterlings Nutrition per E-Mail erhalten
          (ca. einmal im Monat, mit Tipps und Neuigkeiten zu Ernährung und
          Angeboten). Ich kann ihn jederzeit über den Link in jeder E-Mail
          abbestellen. Infos dazu in der{" "}
          <a
            href={newsletter.privacyUrl}
            class="font-medium text-sage-700 underline underline-offset-2"
          >
            Datenschutzerklärung
          </a>
          .
        </label>
      </div>

      <p class="text-muted">
        Du bekommst gleich eine E-Mail zur Bestätigung. Erst danach bist du
        angemeldet.
      </p>
    </form>
  </section>
)}
