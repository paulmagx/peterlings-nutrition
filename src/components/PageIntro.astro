---
import Botanical from "./Botanical.astro";

/** Einheitlicher Kopfbereich für Unterseiten: kleine Überzeile, große Überschrift, Einleitung. */
interface Props {
  eyebrow?: string;
  title: string;
  /** Optional hervorgehobener Teil der Überschrift (wird grün dargestellt). */
  highlight?: string;
  lead?: string;
  /** Zentriert (Standard) oder linksbündig, z. B. für lange Textseiten. */
  align?: "center" | "left";
}
const { eyebrow, title, highlight, lead, align = "center" } = Astro.props;
const centered = align === "center";
---

{centered && (
  <div class="pointer-events-none relative mx-auto hidden max-w-6xl md:block">
    <Botanical
      draw={false}
      class="absolute top-8 -left-6 h-72 -rotate-12 text-sage-300 lg:left-0"
    />
    <Botanical
      draw={false}
      flip
      class="absolute top-16 -right-6 h-60 text-sage-300 lg:right-0"
    />
  </div>
)}

<section
  class:list={[
    "mx-auto max-w-6xl px-5 pt-16 pb-10 sm:px-6 md:pt-24 md:pb-14",
    centered && "text-center",
  ]}
>
  {eyebrow && <p class="text-eyebrow mb-3 text-sage-700">{eyebrow}</p>}
  <h1 class:list={["text-display max-w-4xl", centered && "mx-auto"]}>
    {title} {highlight && <span class="text-sage-700">{highlight}</span>}
  </h1>
  {lead && (
    <p
      class:list={[
        "text-lead mt-5 max-w-2xl text-muted",
        centered && "mx-auto",
      ]}
    >
      {lead}
    </p>
  )}
  <slot />
</section>
