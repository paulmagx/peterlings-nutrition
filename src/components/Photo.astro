---
/**
 * Foto mit automatischer Optimierung (AVIF/WebP, responsive) oder, solange
 * kein Bild vorliegt, ein gestalteter Platzhalter.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import ParsleyMark from "./ParsleyMark.astro";

interface Props {
  image: ImageMetadata | undefined;
  /** Pflicht: Bildbeschreibung (bei rein dekorativen Fotos bewusst leerer String). */
  alt: string;
  sizes?: string;
  class?: string;
  aspect?: "portrait" | "landscape" | "square" | "wide";
  /** Wichtiges Bild über dem Falz sofort laden (statt lazy). */
  eager?: boolean;
}

const {
  image,
  alt,
  sizes = "(min-width: 768px) 50vw, 100vw",
  class: className = "",
  aspect = "landscape",
  eager = false,
} = Astro.props;

const aspectClass = {
  portrait: "aspect-[4/5]",
  landscape: "aspect-[3/2]",
  square: "aspect-square",
  wide: "aspect-[4/3] md:aspect-[16/7]",
}[aspect];

const widths = [320, 480, 640, 800, 1200, 1600];
---

{image ? (
  <Picture
    src={image}
    alt={alt}
    formats={["avif", "webp"]}
    widths={widths}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding={eager ? "sync" : "async"}
    class:list={["w-full rounded-tile object-cover", aspectClass, className]}
  />
) : (
  <div
    class:list={[
      "relative flex w-full flex-col items-center justify-center gap-2 overflow-hidden rounded-tile bg-gradient-to-br from-sage-100 via-sage-50 to-canvas p-6 text-center text-sage-700",
      aspectClass,
      className,
    ]}
    role={alt ? "img" : undefined}
    aria-label={alt ? `Platzhalter: ${alt}` : undefined}
    aria-hidden={alt ? undefined : "true"}
  >
    <ParsleyMark class="absolute -right-[8%] -bottom-[15%] size-[70%] max-h-[28rem] max-w-[28rem] text-sage-200/70" />
    <Icon
      name="photo-camera-outline-rounded"
      class="relative size-8 text-sage-600"
    />
    <p class="relative text-[0.8125rem] font-medium text-sage-800">
      Foto folgt
    </p>
  </div>
)}
