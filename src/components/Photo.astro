---
/**
 * Foto mit automatischer Optimierung (AVIF/WebP, responsive) oder, solange
 * kein Bild vorliegt, ein gestalteter Platzhalter.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

interface Props {
  image: ImageMetadata | undefined;
  /** Pflicht: Bildbeschreibung (bei rein dekorativen Fotos bewusst leerer String). */
  alt: string;
  sizes?: string;
  class?: string;
  aspect?: "portrait" | "landscape" | "square";
  /** Wichtiges Bild über dem Falz sofort laden (statt lazy). */
  eager?: boolean;
}

const {
  image,
  alt,
  sizes = "(min-width: 768px) 50vw, 100vw",
  class: className = "",
  aspect = "landscape",
  eager = false,
} = Astro.props;

const aspectClass = {
  portrait: "aspect-[4/5]",
  landscape: "aspect-[3/2]",
  square: "aspect-square",
}[aspect];

const widths = [320, 480, 640, 800, 1200, 1600];
---

{image ? (
  <Picture
    src={image}
    alt={alt}
    formats={["avif", "webp"]}
    widths={widths}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding={eager ? "sync" : "async"}
    class:list={["w-full rounded-3xl object-cover", aspectClass, className]}
  />
) : (
  <div
    class:list={[
      "flex w-full flex-col items-center justify-center gap-3 rounded-3xl bg-sage-100 p-6 text-center text-sage-700",
      aspectClass,
      className,
    ]}
    role={alt ? "img" : undefined}
    aria-label={alt ? `Platzhalter: ${alt}` : undefined}
    aria-hidden={alt ? undefined : "true"}
  >
    <Icon name="photo-camera-outline-rounded" class="size-16" />
    <p class="text-sm font-semibold">Foto folgt</p>
  </div>
)}
