---
import { site, contact } from "../data/site";
import { isPlaceholder } from "../lib/placeholder";

const url = new URL("/", Astro.site).href;

const hasStreet = !isPlaceholder(contact.street);
const hasCity = !isPlaceholder(contact.city);

const data = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description: site.description,
  url,
  image: new URL("/og-default.png", Astro.site).href,
  founder: { "@type": "Person", name: contact.owner },
  ...(!isPlaceholder(contact.email) && { email: contact.email }),
  ...(!isPlaceholder(contact.phone) && { telephone: contact.phone }),
  ...((hasStreet || hasCity) && {
    address: {
      "@type": "PostalAddress",
      ...(hasStreet && { streetAddress: contact.street }),
      ...(hasCity && { addressLocality: contact.city }),
      addressCountry: "DE",
    },
  }),
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
