---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Seite nicht gefunden" noindex>
  <section class="mx-auto flex max-w-6xl flex-col items-center px-4 py-16 text-center sm:px-6 md:py-24">
    <Icon name="search-off-rounded" class="mb-6 size-24 text-sage-500" />
    <p class="mb-3 text-xs font-bold tracking-widest text-sage-700 uppercase">
      Fehler 404
    </p>
    <h1 class="max-w-2xl text-3xl leading-tight font-extrabold md:text-5xl">
      Hier ist leider <span class="text-sage-700">nichts</span> zu finden.
    </h1>
    <p class="mt-4 max-w-xl text-lg text-muted">
      Die Seite gibt es nicht mehr oder sie wurde verschoben. Vielleicht findest
      du über die Startseite oder unsere Leistungen trotzdem, was du suchst.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Button href="/" variant="primary">
        Zur Startseite
      </Button>
      <Button href="/leistungen" variant="secondary">
        Leistungen ansehen
      </Button>
    </div>
  </section>
</BaseLayout>
