---
/**
 * Impressum (Anbieterkennzeichnung nach § 5 DDG, ggf. § 18 Abs. 2 MStV).
 *
 * WICHTIG: Dieser Text ist eine VORLAGE, keine Rechtsberatung. Vor der Veröffentlichung
 * muss er rechtlich geprüft bzw. mit einem Impressum-Generator (z. B. eRecht24)
 * abgeglichen werden. Alle "TODO(Lea)"-Stellen müssen vorher ersetzt sein.
 *
 * Stammdaten (Name, Anschrift, Kontakt) kommen ausschließlich aus `contact` in
 * src/data/site.ts. Was dort noch fehlt, erscheint hier sichtbar als Platzhalter.
 *
 * Hinweis EU-Streitschlichtung: Die EU-Plattform zur Online-Streitbeilegung (OS-Plattform)
 * wurde am 20.07.2025 eingestellt (VO (EU) 2024/3228). Ein Link darauf gehört daher
 * nicht mehr ins Impressum – beim Abgleich mit dem Generator darauf achten.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { contact } from "../data/site";

/** Lokale Hilfsfunktion: Ist der Wert noch ein Platzhalter aus site.ts? */
const isPlaceholder = (value: string) => value.includes("TODO(");

const todoClass =
  "rounded border border-dashed border-sage-600 bg-sage-100 px-1.5 py-0.5 font-semibold text-sage-900";
const h2Class = "mt-10 text-xl font-extrabold text-ink md:text-2xl";
const pClass = "mt-3 leading-relaxed text-muted";
---

<BaseLayout
  title="Impressum"
  description="Impressum von Peterlings Nutrition – Anbieterkennzeichnung und Kontaktdaten der Ernährungsberatung von Lea Petruschka."
>
  <PageIntro eyebrow="Rechtliches" title="Impressum" />

  <article class="mx-auto max-w-3xl px-4 pb-8 sm:px-6">
    <!-- Block: Anbieterin (§ 5 Abs. 1 Nr. 1 DDG) -->
    <section aria-labelledby="anbieterin">
      <h2 id="anbieterin" class="text-xl font-extrabold text-ink md:text-2xl">
        Angaben gemäß § 5 DDG
      </h2>
      <address class={`${pClass} not-italic`}>
        {contact.owner}
        <br />
        <span class={todoClass}>
          TODO(Lea): Berufsbezeichnung bzw. Firmenbezeichnung, z. B. „Peterlings
          Nutrition – Ernährungsberatung“
        </span>
        <br />
        {isPlaceholder(contact.street) ? (
          <span class={todoClass}>{contact.street}</span>
        ) : (
          contact.street
        )}
        <br />
        {isPlaceholder(contact.city) ? (
          <span class={todoClass}>{contact.city}</span>
        ) : (
          contact.city
        )}
      </address>
      <!-- Anschrift muss ladungsfähig sein (kein Postfach). -->
    </section>

    <!-- Block: Kontakt (§ 5 Abs. 1 Nr. 2 DDG) -->
    <section aria-labelledby="kontakt">
      <h2 id="kontakt" class={h2Class}>
        Kontakt
      </h2>
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-muted">
        <dt class="font-semibold text-ink">E-Mail</dt>
        <dd>
          {isPlaceholder(contact.email) ? (
            <span class={todoClass}>{contact.email}</span>
          ) : (
            <a
              href={`mailto:${contact.email}`}
              class="text-sage-700 underline underline-offset-2 hover:text-sage-800"
            >
              {contact.email}
            </a>
          )}
        </dd>
        <dt class="font-semibold text-ink">Telefon</dt>
        <dd>
          {isPlaceholder(contact.phone) ? (
            <span class={todoClass}>{contact.phone}</span>
          ) : (
            <a
              href={`tel:${contact.phone.replace(/[^\d+]/g, "")}`}
              class="text-sage-700 underline underline-offset-2 hover:text-sage-800"
            >
              {contact.phone}
            </a>
          )}
        </dd>
      </dl>
    </section>

    <!-- Block: Umsatzsteuer (§ 5 Abs. 1 Nr. 6 DDG) – nur eine der beiden Varianten behalten. -->
    <section aria-labelledby="umsatzsteuer">
      <h2 id="umsatzsteuer" class={h2Class}>
        Umsatzsteuer
      </h2>
      <p class={pClass}>
        <span class={todoClass}>
          TODO(Lea): Entweder Umsatzsteuer-Identifikationsnummer gemäß § 27 a
          Umsatzsteuergesetz eintragen (falls vorhanden) oder Hinweis, dass als
          Kleinunternehmerin gemäß § 19 UStG keine Umsatzsteuer berechnet wird.
          Die Steuernummer selbst gehört nicht ins Impressum.
        </span>
      </p>
    </section>

    <!-- Block: Berufsrechtliche Angaben (§ 5 Abs. 1 Nr. 5 DDG) – nur falls zutreffend. -->
    <section aria-labelledby="beruf">
      <h2 id="beruf" class={h2Class}>
        Berufsbezeichnung und Berufsverband
      </h2>
      <p class={pClass}>
        <span class={todoClass}>
          TODO(Lea): Genaue Berufsbezeichnung bzw. Abschluss (z. B. Studium,
          Zertifizierung) und den Staat, in dem er verliehen wurde. Falls du
          Mitglied in einem Berufsverband bist oder einer Kammer bzw.
          berufsrechtlichen Regelungen unterliegst, hier nennen – sonst diesen
          Abschnitt entfernen.
        </span>
      </p>
    </section>

    <!-- Block: Verantwortlich für Inhalte (§ 18 Abs. 2 MStV). Pflicht v. a. bei
         journalistisch-redaktionellen Inhalten (z. B. späterer Blog/Rezepte); schadet sonst nicht. -->
    <section aria-labelledby="verantwortlich">
      <h2 id="verantwortlich" class={h2Class}>
        Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV
      </h2>
      <address class={`${pClass} not-italic`}>
        {contact.owner}
        <br />
        {isPlaceholder(contact.street) ? (
          <span class={todoClass}>{contact.street}</span>
        ) : (
          contact.street
        )}
        <br />
        {isPlaceholder(contact.city) ? (
          <span class={todoClass}>{contact.city}</span>
        ) : (
          contact.city
        )}
      </address>
    </section>

    <!-- Block: Verbraucherstreitbeilegung (§ 36 VSBG). Kein Link auf die eingestellte OS-Plattform. -->
    <section aria-labelledby="streitbeilegung">
      <h2 id="streitbeilegung" class={h2Class}>
        Verbraucherstreitbeilegung / Universalschlichtungsstelle
      </h2>
      <p class={pClass}>
        Ich bin nicht bereit und nicht verpflichtet, an einem
        Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle
        teilzunehmen.
      </p>
      <p class={pClass}>
        <span class={todoClass}>
          TODO(Lea): Bestätigen, dass du nicht an Schlichtungsverfahren
          teilnehmen möchtest – sonst die zuständige Schlichtungsstelle nennen.
        </span>
      </p>
    </section>
  </article>
</BaseLayout>
