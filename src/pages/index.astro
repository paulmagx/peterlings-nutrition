---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import Photo from "../components/Photo.astro";
import Testimonials from "../components/Testimonials.astro";
import { getImage } from "../data/images";
import { serviceTeasers } from "../data/services";
import { contact } from "../data/site";

const formats = contact.formats.join(" & ");
const features = [
  {
    icon: "restaurant-rounded",
    title: "Alltagstauglich",
    text: "Ideen, die zu deinem Alltag, deinem Budget und deinem Geschmack passen.",
  },
  {
    icon: "volunteer-activism-outline",
    title: "Individuell",
    text: "Deine Ziele und Vorlieben bestimmen den Weg, nicht ein Standardplan.",
  },
  {
    icon: "location-on-outline-rounded",
    title: formats.charAt(0).toUpperCase() + formats.slice(1),
    text: "Du entscheidest, wie du mich treffen möchtest.",
  },
];
---

<BaseLayout description="Ernährungsberatung mit Lea Petruschka: alltagstauglich, individuell und auf Augenhöhe – vor Ort und online.">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-20">
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
      <div class="min-w-0">
        <p class="mb-3 text-xs font-bold tracking-widest text-sage-700 uppercase">
          Ernährungsberatung mit Lea Petruschka
        </p>
        <h1 class="text-3xl leading-tight font-extrabold sm:text-4xl md:text-5xl">
          Ernährungsberatung, die in deinen{" "}
          <span class="text-sage-700">Alltag passt.</span>
        </h1>
        <p class="mt-4 max-w-xl leading-relaxed text-muted">
          Ich höre zu, erkläre verständlich und begleite dich Schritt für
          Schritt. So findest du heraus, was dir guttut und was sich gut
          durchhalten lässt.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/termin" icon="arrow-forward-rounded">
            Termin buchen
          </Button>
          <Button href="/leistungen" variant="secondary">
            Leistungen ansehen
          </Button>
        </div>
      </div>
      <!-- TODO(Lea): Titelbild als src/assets/images/hero.jpg ablegen -->
      <Photo
        image={getImage("hero")}
        alt="Gesund zubereitete Mahlzeit"
        aspect="landscape"
        eager
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8 sm:px-6">
    <ul class="grid gap-4 md:grid-cols-3">
      {features.map((f) => (
        <li class="flex items-start gap-4 rounded-2xl bg-sage-50 p-5">
          <Icon name={f.icon} class="size-8 shrink-0 text-sage-700" />
          <div>
            <h2 class="font-bold">{f.title}</h2>
            <p class="mt-1 text-sm leading-relaxed text-muted">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-16">
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
      <!-- TODO(Lea): Porträtfoto als src/assets/images/portrait.jpg ablegen -->
      <Photo
        image={getImage("portrait")}
        alt="Porträtfoto von Lea Petruschka"
        aspect="portrait"
        class="max-w-sm md:max-w-none"
      />
      <div>
        <p class="mb-3 text-xs font-bold tracking-widest text-sage-700 uppercase">
          Über Lea Petruschka
        </p>
        <h2 class="text-2xl font-extrabold md:text-3xl">Hallo, ich bin Lea.</h2>
        <p class="mt-4 leading-relaxed text-muted">
          Für mich bedeutet Ernährung keine Einschränkung, sondern
          Lebensqualität. Ich begleite dich dabei, Gewohnheiten zu finden, die
          zu dir passen und die du gern beibehältst.
        </p>
        <Button
          href="/ueber-mich"
          variant="secondary"
          icon="arrow-forward-rounded"
          class="mt-6"
        >
          Mehr über mich
        </Button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-16">
    <div class="mb-8 flex items-end justify-between gap-4">
      <h2 class="text-2xl font-extrabold md:text-3xl">Leistungen</h2>
      <a
        href="/leistungen"
        class="font-semibold text-sage-700 underline-offset-4 hover:underline"
      >
        Alle Leistungen
      </a>
    </div>
    <ul class="grid gap-4 md:grid-cols-3">
      {serviceTeasers.map((s) => (
        <li>
          <a
            href={s.href}
            class="group flex h-full flex-col rounded-2xl border border-sage-200 bg-white p-6 shadow-sm transition hover:border-sage-400 hover:shadow-md"
          >
            <Icon name={s.icon} class="mb-3 size-8 text-sage-700" />
            <h3 class="text-lg font-bold">{s.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">
              {s.summary}
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-sage-700">
              Mehr erfahren
              <Icon
                name="arrow-forward-rounded"
                class="size-4 transition group-hover:translate-x-0.5"
              />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Testimonials />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
    <div class="rounded-3xl bg-sage-50 p-8 text-center md:p-12">
      <h2 class="text-2xl font-extrabold md:text-3xl">
        Bereit für den ersten Schritt?
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Im Erstgespräch schauen wir gemeinsam, was du dir wünschst und wie ich
        dich unterstützen kann.
      </p>
      <Button href="/termin" icon="arrow-forward-rounded" class="mt-6">
        Termin buchen
      </Button>
    </div>
  </section>
</BaseLayout>
