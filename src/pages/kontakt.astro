---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import ConsentEmbed from "../components/ConsentEmbed.astro";
import { contact } from "../data/site";
import { isPlaceholder } from "../lib/placeholder";

const emailOk = !isPlaceholder(contact.email);
const phoneOk = !isPlaceholder(contact.phone);
const addressOk =
  !isPlaceholder(contact.street) && !isPlaceholder(contact.city);

// TODO(Lea): Adresse/Koordinaten – Platzhalter-Ausschnitt (Mitte Deutschlands), bitte durch Praxisstandort ersetzen.
const mapSrc =
  "https://www.openstreetmap.org/export/embed.html?bbox=9.5%2C50.9%2C10.5%2C51.4&layer=mapnik";

const label = "flex items-center gap-2 text-[0.9375rem] font-medium text-muted";
const value = "mt-3 block text-title break-words [hyphens:manual]";
const missing = "mt-3 block text-lg text-muted";
---

<BaseLayout
  title="Kontakt"
  description="So erreichst du Lea Petruschka: E-Mail, Telefon, Adresse und Beratungsformate."
>
  <PageIntro
    eyebrow="Kontakt"
    title="Schön, dass du "
    highlight="dich meldest."
    lead="Schreib mir oder ruf an – ich melde mich so bald wie möglich bei dir."
  />

  <section
    class="mx-auto max-w-6xl px-5 pt-6 pb-20 sm:px-6 md:pb-28"
    aria-label="Kontaktwege"
  >
    <ul class="grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-4">
      <li class="reveal border-t border-line pt-6">
        <h2 class={label}>
          <Icon name="mail-outline-rounded" class="size-5 text-sage-700" />
          E-Mail
        </h2>
        {emailOk ? (
          <a
            href={`mailto:${contact.email}`}
            class:list={[
              value,
              "text-sage-700 hover:underline underline-offset-4 [font-size:clamp(1.125rem,1rem+0.6vw,1.5rem)]",
            ]}
          >
            {contact.email}
          </a>
        ) : (
          <span class={missing}>wird ergänzt</span>
        )}
      </li>

      <li class="reveal border-t border-line pt-6">
        <h2 class={label}>
          <Icon name="call-outline-rounded" class="size-5 text-sage-700" />
          Telefon
        </h2>
        {phoneOk ? (
          <a
            href={`tel:${contact.phone.replace(/[^+\d]/g, "")}`}
            class:list={[
              value,
              "text-sage-700 hover:underline underline-offset-4 [font-size:clamp(1.125rem,1rem+0.6vw,1.5rem)]",
            ]}
          >
            {contact.phone}
          </a>
        ) : (
          <span class={missing}>wird ergänzt</span>
        )}
      </li>

      <li class="reveal border-t border-line pt-6">
        <h2 class={label}>
          <Icon
            name="location-on-outline-rounded"
            class="size-5 text-sage-700"
          />
          Adresse
        </h2>
        {addressOk ? (
          <address class="mt-3 text-xl leading-snug font-semibold tracking-tight not-italic">
            {contact.owner}
            <br />
            {contact.street}
            <br />
            {contact.city}
          </address>
        ) : (
          <span class={missing}>wird ergänzt</span>
        )}
      </li>

      <li class="reveal border-t border-line pt-6">
        <h2 class={label}>
          <Icon name="forum-outline-rounded" class="size-5 text-sage-700" />
          Beratungsformate
        </h2>
        <ul class="mt-3 text-xl leading-snug font-semibold tracking-tight">
          {contact.formats.map((format) => (
            <li>{format}</li>
          ))}
        </ul>
      </li>
    </ul>
  </section>

  <section class="bg-canvas" aria-label="Nachricht">
    <div class="mx-auto max-w-4xl px-5 py-20 sm:px-6 md:py-32">
      <ContactForm />
    </div>
  </section>

  <section
    class="mx-auto max-w-4xl px-5 py-20 sm:px-6 md:py-32"
    aria-label="Karte"
  >
    <ConsentEmbed
      provider="OpenStreetMap"
      src={mapSrc}
      title="Karte mit dem Standort der Praxis"
      privacyUrl="https://wiki.osmfoundation.org/wiki/Privacy_Policy"
    />
  </section>
</BaseLayout>
