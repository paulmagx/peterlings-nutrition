---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";

const values = [
  {
    icon: "biotech-outline",
    title: "Wissenschaftlich",
    text: "Was ich dir empfehle, stützt sich auf aktuelle Erkenntnisse der Ernährungswissenschaft. Ich übersetze sie so, dass du sie im Alltag wirklich nutzen kannst.",
  },
  {
    icon: "spa-outline",
    title: "Ganzheitlich",
    text: "Essen ist mehr als Nährstoffe. Ich schaue auch auf Alltag, Bewegung, Stress und Schlaf, denn alles zusammen beeinflusst dein Wohlbefinden.",
  },
  {
    icon: "volunteer-activism-outline",
    title: "Individuell",
    text: "Du bist kein Durchschnitt. Deine Ziele, Vorlieben und Lebensumstände bestimmen, was zu dir passt, nicht ein fertiger Standardplan.",
  },
];

const principles = [
  {
    title: "Zuhören zuerst",
    text: "Am Anfang steht dein Alltag: Was beschäftigt dich, was hast du bereits ausprobiert, was soll sich ändern?",
  },
  {
    title: "Kleine Schritte",
    text: "Statt alles auf einmal umzukrempeln, wählen wir Veränderungen, die du wirklich durchhältst.",
  },
  {
    title: "Genuss statt Verbote",
    text: "Ernährung soll Lebensqualität sein und keine Einschränkung. Es gibt keine verbotenen Lebensmittel.",
  },
  {
    title: "Ehrlich und auf Augenhöhe",
    text: "Ich begleite dich und unterstütze dich bei deinen Entscheidungen. Eine ärztliche Behandlung ersetze ich nicht.",
  },
];

const credentials = [
  "Ausbildung / Studium",
  "Zertifizierungen und Weiterbildungen",
  "Berufserfahrung (Jahre, Stationen)",
  "Schwerpunkte und Spezialisierungen",
];
---

<BaseLayout
  title="Über mich"
  description="Lea Petruschka stellt sich vor: Arbeitsweise, Werte und Werdegang."
>
  <PageIntro
    eyebrow="Über Lea Petruschka"
    title="Deine Begleiterin für"
    highlight="Ernährung im Alltag."
    lead="Für mich bedeutet Ernährung keine Einschränkung, sondern Lebensqualität."
  />

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
      <!-- TODO(Lea): Porträtfoto -->
      <div
        class="flex aspect-[4/5] w-full max-w-md flex-col items-center justify-center gap-3 rounded-3xl border-2 border-dashed border-sage-300 bg-sage-50 p-6 text-center text-sage-700 md:max-w-none"
        role="img"
        aria-label="Platzhalter für ein Porträtfoto von Lea Petruschka"
      >
        <Icon name="person-outline-rounded" class="size-20" />
        <p class="text-sm font-semibold">TODO(Lea): Porträtfoto</p>
      </div>

      <div class="flex flex-col gap-4">
        <h2 class="text-2xl font-bold">Hallo, ich bin Lea.</h2>
        <p class="leading-relaxed text-muted">
          Ich bin Lea Petruschka und begleite dich bei Peterlings Nutrition auf
          dem Weg zu deinem persönlichen Wohlbefinden. Für mich bedeutet
          Ernährung keine Einschränkung, sondern Lebensqualität.
        </p>
        <p class="leading-relaxed text-muted">
          Meine Mission: komplexe wissenschaftliche Erkenntnisse in
          alltagstaugliche und genussvolle Gewohnheiten zu übersetzen, damit du
          dich in deinem Körper wohler fühlst.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <h2 class="mb-6 text-2xl font-bold">Wofür ich stehe</h2>
    <ul class="grid gap-4 md:grid-cols-3">
      {values.map((v) => (
        <li class="rounded-2xl border border-sage-100 bg-white p-6 shadow-sm">
          <Icon name={v.icon} class="mb-3 size-8 text-sage-700" />
          <h3 class="mb-2 text-lg font-bold">{v.title}</h3>
          <p class="text-sm leading-relaxed text-muted">{v.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <h2 class="mb-6 text-2xl font-bold">So arbeite ich</h2>
    <ol class="grid gap-4 sm:grid-cols-2">
      {principles.map((p, i) => (
        <li class="flex gap-4 rounded-2xl bg-sage-50 p-5">
          <span
            class="flex size-9 shrink-0 items-center justify-center rounded-full bg-sage-600 font-bold text-white"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <div>
            <h3 class="font-bold">{p.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">{p.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <h2 class="mb-2 text-2xl font-bold">Qualifikationen &amp; Werdegang</h2>
    <p class="mb-6 text-sm text-muted">
      Dieser Bereich wird vor dem Livegang von Lea ergänzt.
    </p>
    <ul class="grid gap-3 sm:grid-cols-2">
      {credentials.map((c) => (
        <li class="flex items-start gap-3 rounded-xl border border-dashed border-sage-300 p-4 text-sm text-muted">
          <Icon
            name="edit-note-outline-rounded"
            class="size-5 shrink-0 text-sage-700"
          />
          <span>TODO(Lea): {c}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
    <div class="rounded-3xl bg-sage-50 p-8 text-center md:p-12">
      <h2 class="text-2xl font-bold md:text-3xl">Lass uns kennenlernen</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Im Erstgespräch schauen wir gemeinsam, was du dir wünschst und wie ich
        dich unterstützen kann.
      </p>
      <Button href="/termin" icon="arrow-forward-rounded" class="mt-6">
        Termin vereinbaren
      </Button>
    </div>
  </section>
</BaseLayout>
