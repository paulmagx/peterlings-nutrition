---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Photo from "../../components/Photo.astro";
import Icon from "../../components/Icon.astro";
import { site, contact } from "../../data/site";
import { getPosts, dateFormat } from "../../lib/wissen";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const isRecipe = data.category === "Rezept";
const url = new URL(`/wissen/${post.id}`, Astro.site).href;
const imageUrl = data.image
  ? new URL(data.image.src, Astro.site).href
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": isRecipe ? "Recipe" : "Article",
  ...(isRecipe ? { name: data.title } : { headline: data.title }),
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  ...(data.updatedDate && { dateModified: data.updatedDate.toISOString() }),
  author: { "@type": "Person", name: contact.owner },
  publisher: { "@type": "Organization", name: site.name },
  mainEntityOfPage: url,
  ...(imageUrl && { image: imageUrl }),
  ...(isRecipe && {
    ...(data.ingredients?.length && { recipeIngredient: data.ingredients }),
    ...(data.portions && { recipeYield: data.portions }),
  }),
};

const hasRecipeInfo =
  isRecipe && (data.portions || data.prepTime || data.ingredients?.length);
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  noindex={data.draft}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <article class="mx-auto max-w-3xl px-5 pt-10 pb-20 sm:px-6 md:pt-16 md:pb-32">
    <a
      href="/wissen"
      class="group inline-flex items-center gap-0.5 text-[0.9375rem] font-medium text-sage-700 underline-offset-4 hover:underline"
    >
      <Icon
        name="chevron-right-rounded"
        class="size-[1.15em] rotate-180 transition-transform group-hover:-translate-x-0.5"
      />
      Zurück zur Übersicht
    </a>

    <header class="mt-8">
      <p class="text-eyebrow flex flex-wrap items-center gap-3 text-sage-700">
        {data.category}
        {data.draft && (
          <span class="rounded-full px-2 py-0.5 text-[0.8125rem] font-medium text-muted ring-1 ring-muted ring-inset">
            Entwurf, nur im Dev-Server sichtbar
          </span>
        )}
      </p>
      <h1 class="text-headline mt-3">{data.title}</h1>
      <p class="text-lead mt-6 text-muted">{data.description}</p>
      <p class="mt-6 text-sm text-muted">
        <time datetime={data.pubDate.toISOString()}>
          {dateFormat.format(data.pubDate)}
        </time>
        {data.updatedDate && (
          <>
            {" "}
            · aktualisiert am{" "}
            <time datetime={data.updatedDate.toISOString()}>
              {dateFormat.format(data.updatedDate)}
            </time>
          </>
        )}
      </p>
    </header>

    {data.image && (
      <Photo
        image={data.image}
        alt={data.imageAlt ?? ""}
        class="mt-10 md:mt-14"
        sizes="(min-width: 768px) 768px, 100vw"
        eager
      />
    )}

    {hasRecipeInfo && (
      <section
        aria-label="Eckdaten und Zutaten"
        class="mt-10 rounded-tile bg-canvas p-8 md:mt-14 md:p-10"
      >
        {(data.portions || data.prepTime) && (
          <dl class="flex flex-wrap gap-x-10 gap-y-4">
            {data.portions && (
              <div>
                <dt class="text-sm text-muted">Portionen</dt>
                <dd class="mt-0.5 text-lg font-semibold">{data.portions}</dd>
              </div>
            )}
            {data.prepTime && (
              <div>
                <dt class="text-sm text-muted">Zubereitung</dt>
                <dd class="mt-0.5 text-lg font-semibold">{data.prepTime}</dd>
              </div>
            )}
          </dl>
        )}
        {data.ingredients && data.ingredients.length > 0 && (
          <>
            <h2
              class:list={[
                "text-title",
                (data.portions || data.prepTime) &&
                  "mt-8 border-t border-line pt-8",
              ]}
            >
              Zutaten
            </h2>
            <ul class="mt-4 divide-y divide-line">
              {data.ingredients.map((item) => (
                <li class="py-3 text-[1.0625rem]">{item}</li>
              ))}
            </ul>
          </>
        )}
      </section>
    )}

    <div class="prose-wissen mt-10 md:mt-14">
      <Content />
    </div>

    <p class="mt-16 rounded-tile bg-canvas p-6 text-[0.9375rem] text-muted md:p-8">
      Dieser Beitrag ersetzt keine ärztliche Beratung. Bei Beschwerden oder
      Erkrankungen sprich bitte vorher mit deiner Ärztin oder deinem Arzt.
    </p>

    <a
      href="/wissen"
      class="group mt-10 inline-flex items-center gap-0.5 text-[0.9375rem] font-medium text-sage-700 underline-offset-4 hover:underline"
    >
      <Icon
        name="chevron-right-rounded"
        class="size-[1.15em] rotate-180 transition-transform group-hover:-translate-x-0.5"
      />
      Zurück zur Übersicht
    </a>
  </article>
</BaseLayout>

<style is:global>
  .prose-wissen {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-ink);
    letter-spacing: -0.012em;
  }
  .prose-wissen > * + * {
    margin-top: 1.5rem;
  }
  .prose-wissen h2 {
    margin-top: 3.5rem;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.022em;
    font-weight: 650;
    text-wrap: balance;
  }
  .prose-wissen h3 {
    margin-top: 2.5rem;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    font-weight: 650;
  }
  .prose-wissen h2 + *,
  .prose-wissen h3 + * {
    margin-top: 1rem;
  }
  .prose-wissen ul,
  .prose-wissen ol {
    padding-left: 1.5rem;
  }
  .prose-wissen ul {
    list-style: disc;
  }
  .prose-wissen ol {
    list-style: decimal;
  }
  .prose-wissen li {
    padding-left: 0.25rem;
  }
  .prose-wissen li + li {
    margin-top: 0.625rem;
  }
  .prose-wissen li::marker {
    color: var(--color-muted);
  }
  .prose-wissen a {
    color: var(--color-sage-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-wissen a:hover {
    color: var(--color-sage-800);
  }
  .prose-wissen strong {
    font-weight: 650;
  }
  .prose-wissen blockquote {
    border-left: 2px solid var(--color-line);
    padding-left: 1.25rem;
    color: var(--color-muted);
  }
  .prose-wissen hr {
    border: 0;
    border-top: 1px solid var(--color-line);
    margin-block: 3rem;
  }
</style>
