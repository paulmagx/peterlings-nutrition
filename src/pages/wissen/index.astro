---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import Photo from "../../components/Photo.astro";
import { getPosts, dateFormat } from "../../lib/wissen";

const posts = await getPosts();
const sections = [
  { id: "rezepte", title: "Rezepte", category: "Rezept" },
  { id: "wissen", title: "Wissen", category: "Wissen" },
]
  .map((s) => ({
    ...s,
    posts: posts.filter((p) => p.data.category === s.category),
  }))
  .filter((s) => s.posts.length > 0);
---

<BaseLayout
  title="Wissen und Rezepte"
  description="Alltagstaugliche Rezepte und verständliche Beiträge rund um Ernährung von Lea Petruschka."
>
  <PageIntro
    eyebrow="Wissen"
    title="Rezepte und Wissen für"
    highlight="deinen Alltag."
    lead="Einfache Ideen für ausgewogene Mahlzeiten und verständliche Beiträge rund um Ernährung."
  />

  {posts.length === 0 ? (
    <div class="mx-auto max-w-6xl px-5 py-20 text-center sm:px-6 md:py-32">
      <p class="text-headline mx-auto max-w-3xl text-ink">
        Hier erscheinen bald Rezepte und Wissensbeiträge.
      </p>
      <p class="text-lead mx-auto mt-5 max-w-xl text-muted">
        Schau gern bald wieder vorbei.
      </p>
    </div>
  ) : (
    <>
      {sections.length > 1 && (
        <nav
          aria-label="Abschnitte"
          class="mx-auto flex max-w-6xl justify-center gap-8 px-5 pb-10 sm:px-6"
        >
          {sections.map((s) => (
            <a
              href={`#${s.id}`}
              class="font-medium text-sage-700 underline-offset-4 hover:underline"
            >
              {s.title}
            </a>
          ))}
        </nav>
      )}

      {sections.map((s, i) => (
        <section
          id={s.id}
          aria-labelledby={`${s.id}-titel`}
          class:list={[
            "scroll-mt-16",
            i % 2 === 1 ? "bg-canvas" : "border-t border-line bg-surface",
          ]}
        >
          <div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 md:py-32">
            <h2 id={`${s.id}-titel`} class="text-headline text-center">
              {s.title}
            </h2>
            <ul
              class:list={[
                "mt-14 grid gap-x-8 gap-y-14 md:mt-20",
                s.posts.length === 1 ? "mx-auto max-w-xl" : "md:grid-cols-2",
              ]}
            >
              {s.posts.map((post) => (
                <li>
                  <article class="group relative flex h-full flex-col">
                    <div class="overflow-hidden rounded-tile">
                      <Photo
                        image={post.data.image}
                        alt={post.data.imageAlt ?? ""}
                        sizes="(min-width: 1152px) 552px, (min-width: 768px) 50vw, 100vw"
                        class="transition-transform duration-500 ease-soft group-hover:scale-[1.03]"
                      />
                    </div>
                    <div class="flex flex-1 flex-col pt-6">
                      <p class="text-eyebrow flex flex-wrap items-center gap-2 text-sage-700">
                        {post.data.category}
                        {post.data.draft && (
                          <span class="rounded-full px-2 py-0.5 text-[0.8125rem] font-medium text-muted ring-1 ring-muted ring-inset">
                            Entwurf
                          </span>
                        )}
                      </p>
                      <h3 class="text-title mt-2">
                        <a
                          href={`/wissen/${post.id}`}
                          class="after:absolute after:inset-0 after:content-['']"
                        >
                          {post.data.title}
                        </a>
                      </h3>
                      <p class="mt-3 text-muted">{post.data.description}</p>
                      <p class="mt-auto pt-5 text-sm text-muted">
                        <time datetime={post.data.pubDate.toISOString()}>
                          {dateFormat.format(post.data.pubDate)}
                        </time>
                      </p>
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </>
  )}
</BaseLayout>
