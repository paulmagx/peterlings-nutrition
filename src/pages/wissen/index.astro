---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import Photo from "../../components/Photo.astro";
import Icon from "../../components/Icon.astro";
import { getPosts, dateFormat } from "../../lib/wissen";

const posts = await getPosts();
const sections = [
  { id: "rezepte", title: "Rezepte", category: "Rezept" },
  { id: "wissen", title: "Wissen", category: "Wissen" },
]
  .map((s) => ({
    ...s,
    posts: posts.filter((p) => p.data.category === s.category),
  }))
  .filter((s) => s.posts.length > 0);
---

<BaseLayout
  title="Wissen und Rezepte"
  description="Alltagstaugliche Rezepte und verständliche Beiträge rund um Ernährung von Lea Petruschka."
>
  <PageIntro
    eyebrow="Wissen"
    title="Rezepte und Wissen für"
    highlight="deinen Alltag."
    lead="Einfache Ideen für ausgewogene Mahlzeiten und verständliche Beiträge rund um Ernährung."
  />

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    {posts.length === 0 ? (
      <p class="rounded-2xl bg-sage-50 p-8 text-center text-muted">
        Hier erscheinen bald Rezepte und Wissensbeiträge.
      </p>
    ) : (
      <>
        <nav aria-label="Abschnitte" class="mb-10 flex flex-wrap gap-2">
          {sections.map((s) => (
            <a
              href={`#${s.id}`}
              class="rounded-full bg-sage-100 px-4 py-2 text-sm font-semibold text-sage-800 transition-colors hover:bg-sage-200"
            >
              {s.title}
            </a>
          ))}
        </nav>

        {sections.map((s) => (
          <section id={s.id} class="mb-12 scroll-mt-24">
            <h2 class="text-2xl font-extrabold md:text-3xl">{s.title}</h2>
            <ul class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {s.posts.map((post) => (
                <li>
                  <article class="relative flex h-full flex-col overflow-hidden rounded-2xl border border-sage-200 bg-white p-4 shadow-sm transition-shadow focus-within:shadow-lg hover:shadow-lg">
                    <Photo
                      image={post.data.image}
                      alt={post.data.imageAlt ?? ""}
                      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                    />
                    <div class="flex flex-1 flex-col px-2 pt-4 pb-2">
                      <p class="flex flex-wrap items-center gap-2 text-xs font-bold tracking-widest text-sage-700 uppercase">
                        <Icon
                          name={
                            post.data.category === "Rezept"
                              ? "restaurant-outline-rounded"
                              : "lightbulb-outline-rounded"
                          }
                          class="size-5"
                        />
                        {post.data.category}{" "}
                        {post.data.draft && (
                          <span class="rounded-full bg-amber-100 px-2 py-0.5 tracking-normal text-amber-900 normal-case">
                            Entwurf
                          </span>
                        )}
                      </p>
                      <h3 class="mt-2 text-xl font-bold">
                        <a
                          href={`/wissen/${post.id}`}
                          class="after:absolute after:inset-0 after:content-['']"
                        >
                          {post.data.title}
                        </a>
                      </h3>
                      <p class="mt-2 text-sm leading-relaxed text-muted">
                        {post.data.description}
                      </p>
                      <p class="mt-auto pt-4 text-xs text-muted">
                        <time datetime={post.data.pubDate.toISOString()}>
                          {dateFormat.format(post.data.pubDate)}
                        </time>
                      </p>
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </>
    )}
  </div>
</BaseLayout>
